<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- No network, storage, accessibility or device-admin permissions. -->
    <application android:allowBackup="false" android:label="@string/app_name"
        android:icon="@drawable/ic_launcher" android:theme="@style/LauncherTheme">
        <!-- NoDisplay: it only redirects, so no window (and no e-ink refresh) is drawn.
             Every path through HomeActivity calls finish() in onCreate, as NoDisplay requires. -->
        <activity android:name=".HomeActivity" android:exported="true"
            android:launchMode="singleTask" android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name=".RecoveryActivity" android:exported="true"
            android:launchMode="singleTask" android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
